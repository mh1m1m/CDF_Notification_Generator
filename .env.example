# CDF V13 Enterprise — SYNTHETIC-DATA REFERENCE IMPLEMENTATION, not CDF production.
# Variable NAMES only. Values live in an untracked .env.local (developers) or in Vercel as sensitive variables.
# Never commit a value, and never prefix a secret with NEXT_PUBLIC_.

# --- Web app (server side only) ---
# Connection URL of the app login cdf_v13_app (TLS required unless 127.0.0.1/localhost).
V13_DATABASE_URL=
# Optional pool size of the app's database client, 1–20 (default 3).
V13_DB_POOL_MAX=
# Session signing secret: base64url text that decodes to at least 32 random bytes.
V13_SESSION_SECRET=
# Persona sign-in switch: exactly "enabled" turns it on; anything else (or empty) keeps it off.
V13_PERSONA_SIGNIN=
# Isolation probe switch: exactly "enabled" exposes GET /api/health/isolation; otherwise it answers 404.
V13_ISOLATION_PROBE=

# --- Database tooling (local and CI only) ---
# Administrator URL for db:migrate and db:reset (loopback only; default: local primary cluster as postgres).
V13_ADMIN_DATABASE_URL=
# History runner value written by db:migrate: local or ci (default: ci when CI=true, else local).
V13_MIGRATION_RUNNER=
# Port of the local primary cluster started by db:local (default 54329).
V13_LOCAL_PG_PORT=
# Port of the local hosted-simulation cluster started by db:local (default 54330).
V13_LOCAL_HOSTED_SIM_PORT=
# OS user that runs local PostgreSQL when the scripts run as root (default postgres).
V13_LOCAL_PG_OS_USER=
# PostgreSQL server bin directory if pg_config is not on PATH (for example /usr/lib/postgresql/16/bin).
V13_PG_BIN=
# Local/CI-only password that db:reset sets on cdf_v13_app (default: a fixed non-secret test value).
V13_LOCAL_APP_PASSWORD=
# Superuser URL of the hosted-simulation cluster used by integration tests (default: local cluster on 54330).
V13_HOSTED_SIM_SUPERUSER_URL=
# Optional per-test timeout of the integration suite in milliseconds (default 60000).
V13_DB_TEST_TIMEOUT_MS=
# Set to 1 (CI) to make an unreachable test cluster fail the integration suite instead of skipping it.
V13_DB_TESTS_REQUIRED=

# --- End-to-end tests ---
# Base URL of an already running deployment to test instead of building and starting the app locally.
V13_E2E_BASE_URL=
# Optional session secret for the locally started e2e server; generated at run time when empty.
V13_E2E_SESSION_SECRET=
# Database of the locally started e2e server: loopback v13_local only (default: local primary cluster as cdf_v13_app).
V13_E2E_DATABASE_URL=
# Screenshot library: "library" adds the visual-library project (CI visual job); "index" rewrites its index locally.
V13_E2E_VISUAL=
# Chromium executable for Playwright in sandboxes without downloaded browsers (CI installs its own).
PW_CHROMIUM_PATH=
